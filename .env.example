# Application Configuration
APP_NAME=ZQAutoNXG
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# CORS Configuration
# Add production origins explicitly when the web UI is hosted separately.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:1420,tauri://localhost

# Deployment secrets
# Generate unique values locally and copy this file to .env. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-different-long-random-password
GRAFANA_ADMIN_PASSWORD=replace-with-a-third-long-random-password

# Optional direct service URLs (Compose constructs these internally from the
# passwords above; set them when running the API outside Compose).
DATABASE_URL=postgresql://zqadmin:replace-with-a-long-random-password@localhost:5432/zqautonxg
REDIS_URL=redis://:replace-with-a-different-long-random-password@localhost:6379/0

# Runtime capability declarations. Leave unset/false until the corresponding
# integrations have actually been configured and probed.
ZQ_COMPONENTS_READY=false
ZQ_AI_LOGIC_ENABLED=false
ZQ_AI_LOGIC_VERSION=unknown

# Security Configuration (reserved for integrations that consume them)
JWT_SECRET_KEY=replace-with-a-unique-secret-if-enabled
ENCRYPTION_KEY=replace-with-a-unique-key-if-enabled

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=replace-if-email-is-enabled

# Optional governed AI PR review. If omitted, secret scanning still runs and
# the Gemini review step skips cleanly.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Git/build information (normally injected by CI/CD)
GIT_COMMIT=unknown
BUILD_DATE=unknown
